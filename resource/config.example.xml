<?xml version="1.0" encoding="UTF-8"?>
<MyQSLConfig>
    <Settings>
        <QSOHistory>20</QSOHistory>

        <!-- enables pota specific options like logging park numbers
             and exporting adif logs in pota format -->
        <EnablePota>true</EnablePota>

        <Database>
            <Handler>sqlite3</Handler>
            <DBPath>./resource/MyQSL.db</DBPath>
            <!--
            <Handler>MySQL</Handler>
            <Host>127.0.0.1:3306</Host>
            <User>DB_USER</User>
            <Pass>DB_PASS</Pass>
            -->
        </Database>
        <QSLCard>
            <EmailSubject>QSL card from CALLSIGN</EmailSubject>
            <EmailBody>It was a pleasure connecting with you earlier. Please find the attached card. 73!</EmailBody>
            <BackdropPath>./resource/img/backdrops/</BackdropPath>
            <ThumbnailPath>./static/img/backdrops/</ThumbnailPath>
            <CardOutput>./static/img/</CardOutput>
            <OverlayImage>./resource/img/Overlay.png</OverlayImage>
            <IconPath>./resource/img/icon.png</IconPath>

            <!-- the text that gets drawn onto the overlay image -->
            <QSODetails>
                <RowSpace>70</RowSpace>
                <Col1Left>170</Col1Left>
                <Col2Left>400</Col2Left>
                <InitBase>575</InitBase>
            </QSODetails>
            <Icon>
                <MarginBottom>200</MarginBottom>
                <MarginRight>120</MarginRight>
            </Icon>
            <Message>
                <Text>73s from STATE!</Text>
                <Left>120</Left>
                <Base>100</Base>
            </Message>
        </QSLCard>

        <!-- options that show up in the band dropdown -->
        <Bands>2200m,630m,160m,80m,60m,40m,30m,20m,17m,15m,12m,10m,6m,2m,1.25m,70cm,33cm,23cm</Bands>

        <!-- frequency range for each band in MHz
             used for auto band selection when frequency is input first -->
        <FreqRange>
            <Band2200m>0.1357-0.1378</Band2200m>
            <Band630m>0.472-0.479</Band630m>
            <Band160m>1.800-2.000</Band160m>
            <Band80m>3.500-4.000</Band80m>
            <Band60m>5.330-5.410</Band60m>
            <Band40m>7.000-7.300</Band40m>
            <Band30m>10.100-10.150</Band30m>
            <Band20m>14.000-14.350</Band20m>
            <Band17m>18.068-18.168</Band17m>
            <Band15m>21.000-21.450</Band15m>
            <Band12m>24.890-24.990</Band12m>
            <Band10m>28.000-29.700</Band10m>
            <Band6m>50.000-54.000</Band6m>
            <Band2m>144.0-148.0</Band2m>
            <Band1.25m>219.0-225.0</Band1.25m>
            <Band70cm>420.0-450.0</Band70cm>
            <Band33cm>902.0-928.0</Band33cm>
            <Band23cm>1240.0-1300.0</Band23cm>
        </FreqRange>

        <!-- quick band selection buttons that show up next to the band dropdown -->
        <QuickBand>80m,40m,30m,20m,17m,15m,12m,10m</QuickBand>

        <!-- quick mode selection buttons that show up next to the mode field -->
        <QuickMode>FM,AM,SSB,FT8,FT4</QuickMode>

        <!-- used to set frequencies when a mode is selected.
             if the current frequency was manually entered by
             the user, and that frequency is inside the selected
             band, then it will not be overwritten -->
        <QuickFreq>
            <FM>
                <Band2m>144.000</Band2m>
                <Band70cm>420.000</Band70cm>
            </FM>
            <SSB>
                <Band80m>3.600</Band80m>
                <Band40m>7.125</Band40m> 
                <Band20m>14.150</Band20m>
                <Band17m>18.110</Band17m>
                <Band15m>21.200</Band15m>
                <Band12m>24.930</Band12m>
                <Band10m>28.300</Band10m>
            </SSB>
            <FT4>
                <Band80m>3.575</Band80m>
                <Band40m>7.0475</Band40m>
                <Band30m>10.140</Band30m>
                <Band20m>14.080</Band20m>
                <Band17m>18.104</Band17m>
                <Band15m>21.140</Band15m>
                <Band12m>24.919</Band12m>
                <Band10m>28.180</Band10m>
            </FT4> 
            <FT8>
                <Band80m>3.573</Band80m>
                <Band40m>7.074</Band40m>
                <Band30m>10.136</Band30m>
                <Band20m>14.074</Band20m>
                <Band17m>18.100</Band17m>
                <Band15m>21.074</Band15m>
                <Band12m>24.915</Band12m>
                <Band10m>28.074</Band10m>
            </FT8>
        </QuickFreq>
        <QuickRSTS>57,58,59</QuickRSTS>
        <QuickRSTR>57,58,59</QuickRSTR>
    </Settings>
    <O365>
        <Credentials>
            <ClientID>YOUR_CLIENT_ID</ClientID>
            <TenantID>YOUR_TENANT_ID</TenantID>
            <SecretValue>YOUR_SECRET_VALUE</SecretValue>
            <ClientSecret>YOUR_CLIENT_SECRET</ClientSecret>
            <Email>YOUR_EMAIL</Email>
        </Credentials>
    </O365>
    <QRZ>
        <UserAPI>https://xmldata.qrz.com/xml/current</UserAPI>
        <LogbookAPI>https://logbook.qrz.com/api</LogbookAPI>
        <Credentials>
            <Callsign>YOUR_CALLSIGN</Callsign>
            <Password>YOUR_PASSWORD</Password>
            <APIKey>YOUR_API_KEY</APIKey>
        </Credentials>
    </QRZ>
</MyQSLConfig>
